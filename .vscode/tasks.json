{
  // Ctrl + Shift + B  → chạy website (npm run dev)
  // Terminal → Run Task… → chọn task muốn chạy
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chạy website (npm run dev)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "options": { "env": { "VSCODE_LAUNCH": "1" } },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeAtBeginning": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Cài đặt thư viện (npm install)",
      "type": "npm",
      "script": "install",
      "problemMatcher": []
    },
    {
      "label": "Đóng gói để đưa lên mạng (npm run build)",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    }
  ]
}
